{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "jsx-a11y"],
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    "dist",
    "coverage",
    "playwright-report",
    "test-results",
    "amplify/.config",
    "lai/apps/assets/static/assets/admin/asset-preview.js"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "eqeqeq": "error",
    "no-console": ["warn", { "allow": ["warn", "error"] }]
  },
  "overrides": [
    {
      "files": ["scripts/**", "server/**"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
