# Reference for local Django settings (config.settings.local). Django does not read this file:
# export the values in the shell that runs `make runserver`. Nothing here is a secret.
# docs/TREASURE_RUSH_LOCAL_DEV.md; ADR-038.

# API sign-in: `django` (the default while DJANGO_DEBUG is on) or `cognito`. Anything else, or no
# value with DJANGO_DEBUG=false, stops Django at start-up. Production always uses `cognito`.
AUTH_PROVIDER=django
DJANGO_DEBUG=true

# Only with AUTH_PROVIDER=cognito (values from amplify_outputs.json of a test sandbox):
# COGNITO_REGION=
# COGNITO_USER_POOL_ID=
# COGNITO_ALLOWED_CLIENT_IDS=

# Only when calling Django from another origin than the Vite proxy (rare):
# DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Optional: DATABASE_URL overrides the docker-compose PostgreSQL (`make up`).
# DATABASE_URL=postgresql://lai:local-dev-only-password@127.0.0.1:5432/lai
