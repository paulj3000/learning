# Reference for local Django settings (config.settings.local). Django does not read this file:
# export the values in the shell that runs `make runserver`. Nothing here is a secret.
# docs/TREASURE_RUSH_LOCAL_DEV.md; ADR-040.

DJANGO_DEBUG=true

# API authentication is Cognito in every environment (ADR-040). Use the values from the
# amplify_outputs.json of a test sandbox. Without all three, every API request is rejected.
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_ALLOWED_CLIENT_IDS=

# Optional: DATABASE_URL overrides the docker-compose PostgreSQL (`make up`).
# DATABASE_URL=postgresql://lai:local-dev-only-password@127.0.0.1:5432/lai
