{
  "name": "learning-adventure-island-root",
  "version": "0.1.0",
  "description": "AI-powered educational adventures for children built with AWS Amplify Gen 2.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "react"
  ],
  "scripts": {
    "dev": "npm run dev -w react",
    "build": "npm run build -w react",
    "preview": "npm run preview -w react",
    "typecheck": "npm run typecheck -w react",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -w react",
    "test:e2e": "npm run test:e2e -w react",
    "sandbox": "ampx sandbox",
    "ai:red-team": "tsx scripts/ai-red-team.ts",
    "assets:generate": "tsx scripts/generate-world-assets.ts"
  }
}
