# lai-release: installed by scripts/aws/native/deploy-native.sh as /etc/nginx/conf.d/lai.conf
# (http context), rendered with envsubst for ${LAI_API_HOST} and ${LAI_ADMIN_HOST} only. Native dev
# environment: nginx terminates TLS (Let's Encrypt, cert `lai-dev`) in front of gunicorn on
# 127.0.0.1:8000. setup-native.sh never overwrites this file once a release has installed it.
#
# Host isolation (as deploy/ec2/nginx, LAI-INFRA-003):
#   ${LAI_API_HOST}    /api/ only (CloudFront forwards the React app's API calls here)
#   ${LAI_ADMIN_HOST}  the Django Admin and its static files (WhiteNoise); `/` -> /admin/; never /api/
#   anything else      443: connection closed (444); 80: ACME challenges and a redirect to https
#   127.0.0.1:8080     plain HTTP, loopback only: health probes for the release scripts, presented
#                      to Django as the API host
#
# Privacy (ADR-025, gate G10): no access log, because request paths carry child ids; the error log
# is limited to `crit` (nginx puts the request line in error entries). HSTS is left to Django.

server_tokens off;
access_log off;
error_log /var/log/nginx/error.log crit;

client_max_body_size 55m; # asset uploads are capped at 50 MB by Django
client_body_timeout 60s;
proxy_read_timeout 35s; # gunicorn's own timeout is 30 s
proxy_http_version 1.1;
absolute_redirect off;

ssl_certificate /etc/letsencrypt/live/lai-dev/fullchain.pem;
ssl_certificate_key /etc/letsencrypt/live/lai-dev/privkey.pem;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_prefer_server_ciphers off;
ssl_session_cache shared:lai_tls:5m;
ssl_session_timeout 1h;
ssl_session_tickets off;

upstream lai_django {
    server 127.0.0.1:8000;
    keepalive 16;
}

# Admin login attempts: 10 POSTs a minute per client address, burst 5. Other methods are not keyed.
map $request_method $lai_admin_login_key {
    POST    $binary_remote_addr;
    default "";
}
limit_req_zone $lai_admin_login_key zone=lai_admin_login:1m rate=10r/m;
limit_req_status 429;

# Every location sets all its headers: nginx does not inherit proxy_set_header into a block that
# sets any of its own.

# --- port 80: ACME HTTP-01 and a redirect --------------------------------------------------------
server {
    listen 80 default_server;
    server_name _;

    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/lai/acme;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- 443: unknown hosts --------------------------------------------------------------------------
server {
    listen 443 ssl default_server;
    server_name _;
    return 444;
}

# --- 443: the API, /api/ only -------------------------------------------------------------------
server {
    listen 443 ssl;
    server_name ${LAI_API_HOST};

    location /api/ {
        proxy_set_header Host $host;
        proxy_set_header Connection '';
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://lai_django;
    }

    location / {
        return 404;
    }
}

# --- 443: the Django Admin, never the API --------------------------------------------------------
server {
    listen 443 ssl;
    server_name ${LAI_ADMIN_HOST};

    location = / {
        return 302 /admin/;
    }

    location /api/ {
        return 404;
    }

    location = /admin/login/ {
        limit_req zone=lai_admin_login burst=5 nodelay;
        proxy_set_header Host $host;
        proxy_set_header Connection '';
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://lai_django;
    }

    location / {
        proxy_set_header Host $host;
        proxy_set_header Connection '';
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://lai_django;
    }
}

# --- 127.0.0.1:8080: local health probes only ----------------------------------------------------
server {
    listen 127.0.0.1:8080 default_server;
    server_name _;

    location = /nginx-health {
        default_type text/plain;
        return 200 "ok\n";
    }

    location ~ ^/api/v1/health/(ready/)?$ {
        proxy_set_header Host ${LAI_API_HOST};
        proxy_set_header Connection '';
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_pass http://lai_django;
    }

    location / {
        return 404;
    }
}
