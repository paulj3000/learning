# Installed by scripts/aws/native/deploy-native.sh from the release being deployed.
# The processing outbox relay (LAI-LAMBDA-004/005, docs/processing/WAVE2_INTERFACES.md section 6):
# sends committed outbox rows to the processing work queue. A crash between a send and its
# mark causes a duplicate send, never a lost job. Stopped first by power-native.sh quiesce, so no
# new work leaves while the instance stops. Failures retry every 30 s without a start limit.
[Unit]
Description=Learning Adventure Island processing outbox relay (work dispatch)
After=network-online.target lai-gunicorn.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=lai
Group=lai
WorkingDirectory=/opt/lai/current/lai
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
Environment=DJANGO_TRUST_PROXY_SSL_HEADER=true
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/lai/runtime/django.env
EnvironmentFile=/opt/lai/current/release.env
# Skipped (not failed) unless the processing backend is sqs: LaiProcessing-<env> writes
# `disabled` until a worker image is deployed, and systemd then never starts or restarts it.
ExecCondition=/usr/bin/test "${LAI_PROCESSING_BACKEND}" = sqs
ExecStart=/opt/lai/current/venv/bin/python manage.py jobs_dispatch
TimeoutStopSec=40
Restart=on-failure
RestartSec=30
StandardOutput=append:/var/log/lai/jobs-dispatch.log
StandardError=inherit
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/log/lai
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
