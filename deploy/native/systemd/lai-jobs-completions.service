# Installed by scripts/aws/native/deploy-native.sh from the release being deployed.
# The processing completion consumer (LAI-LAMBDA-004/005, docs/processing/WAVE2_INTERFACES.md
# sections 5 and 6): applies worker completions and acknowledges each only after its transaction
# commits, so a stop at any point loses nothing (the message is delivered again). Completions that
# arrive while the instance is stopped wait in SQS (14 days). Failures retry every 30 s.
[Unit]
Description=Learning Adventure Island processing completion consumer
After=network-online.target lai-gunicorn.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=lai
Group=lai
WorkingDirectory=/opt/lai/current/lai
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
Environment=DJANGO_TRUST_PROXY_SSL_HEADER=true
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/lai/runtime/django.env
EnvironmentFile=/opt/lai/current/release.env
# Skipped (not failed) unless the processing backend is sqs: LaiProcessing-<env> writes
# `disabled` until a worker image is deployed, and systemd then never starts or restarts it.
ExecCondition=/usr/bin/test "${LAI_PROCESSING_BACKEND}" = sqs
ExecStart=/opt/lai/current/venv/bin/python manage.py jobs_consume_completions
TimeoutStopSec=60
Restart=on-failure
RestartSec=30
StandardOutput=append:/var/log/lai/jobs-completions.log
StandardError=inherit
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/log/lai
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
