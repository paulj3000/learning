# Instance-local reverse proxy in front of gunicorn (ADR-037). The ALB terminates TLS (ACM) and is
# the only client the instance's security group admits on 8080. nginx buffers slow clients so the
# synchronous gunicorn workers never wait on the network, caps request bodies at the asset upload
# limit, and keeps gunicorn off every public interface.
#
# The nginx image renders this template with envsubst; only ${LAI_API_HOST} and ${LAI_ADMIN_HOST}
# are substituted (nginx's own $variables are left alone because they are not in the environment).
#
# Host isolation (LAI-INFRA-003). The load balancer forwards only these two host names; nginx then
# limits each to its own paths, so neither host exposes the other's surface:
#   ${LAI_API_HOST}    /api/ only (the React app reaches it same-origin through CloudFront)
#   ${LAI_ADMIN_HOST}  the Django Admin and its static files; never /api/
# Anything else (target health checks carry the instance IP as Host) reaches the default server,
# which answers health probes and nothing more.
#
# Privacy (ADR-025, gate G10): no access log, because request paths carry child ids. Django writes
# its own privacy-filtered request line. The error log is limited to `crit` for the same reason
# (nginx puts the request line in error entries).

server_tokens off;
access_log off;
error_log /dev/stderr crit;

# The ALB sets X-Forwarded-Proto; the deploy script's local check over plain HTTP does not.
map $http_x_forwarded_proto $lai_forwarded_proto {
    default $http_x_forwarded_proto;
    ''      http;
}

upstream lai_django {
    server django:8000;
    keepalive 16;
}

# Shared by every server: limits sized for gunicorn and the asset upload cap.
# Asset uploads are capped at 50 MB by Django (LAI_ASSET_MAX_UPLOAD_BYTES); allow the form
# overhead, refuse anything larger before it reaches gunicorn.
client_max_body_size 55m;
client_body_timeout 60s;
proxy_read_timeout 35s; # gunicorn's own timeout is 30 s
proxy_http_version 1.1;
# Redirects nginx itself issues stay relative: an absolute one would name nginx's own port and
# scheme (http, 8080), not the https address the browser used at the load balancer.
absolute_redirect off;

# Every location sets all its headers: nginx does not inherit proxy_set_header into a block that
# sets any of its own.

# Load balancer target checks and anything with an unknown Host.
server {
    listen 8080 default_server;

    location = /nginx-health {
        default_type text/plain;
        return 200 "ok\n";
    }

    # Health probes arrive with the instance IP as Host (ALB target checks). Present the API host
    # name so Django's ALLOWED_HOSTS stays strict for everything else.
    location ~ ^/api/v1/health/(ready/)?$ {
        proxy_set_header Host ${LAI_API_HOST};
        proxy_set_header Connection '';
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $lai_forwarded_proto;
        proxy_pass http://lai_django;
    }

    location / {
        return 404;
    }
}

# The API: /api/ only. No admin, no admin static files.
server {
    listen 8080;
    server_name ${LAI_API_HOST};

    location = /nginx-health {
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        proxy_set_header Host $host;
        proxy_set_header Connection '';
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $lai_forwarded_proto;
        proxy_pass http://lai_django;
    }

    location / {
        return 404;
    }
}

# The Django Admin (DJANGO_ADMIN_URL_PATH, default admin/) and its static files (WhiteNoise, from
# the image). Never the API: asset file URLs are issued to the React app, not to the admin.
server {
    listen 8080;
    server_name ${LAI_ADMIN_HOST};

    location = / {
        return 302 /admin/;
    }

    location /api/ {
        return 404;
    }

    location / {
        proxy_set_header Host $host;
        proxy_set_header Connection '';
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $lai_forwarded_proto;
        proxy_pass http://lai_django;
    }
}
