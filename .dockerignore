# Django image build context (lai/Dockerfile). Only requirements.txt, lai/, content/ and the bundled
# models (react/public/models, for `manage.py import_assets --from-bundled`) are copied.
**/__pycache__
**/*.pyc
.venv
node_modules
react/*
!react/public
react/public/*
!react/public/models
amplify
dist
.git
lai/staticfiles
*.env
.env*
