# Settings for the native DEV environment scripts (scripts/aws/deploy-debug.sh, install-debug.sh,
# manage-dev.sh, show-endpoints.sh, dev-release.sh). Copy to <repo>/.lai-dev.env (git-ignored)
# or point LAI_DEV_ENV_FILE at a copy. KEY=value lines only: the file is parsed, never sourced.
# A variable already set in the environment wins over this file. An unset setting reuses the
# value the deployed stack already has, then the default shown. An unquoted empty value (KEY=)
# counts as unset; write KEY="" to set a value to empty on purpose.
# No secrets belong here: the Django secret key and the admin password live in SSM.

# --- account and AWS CLI ------------------------------------------------------------------------
# The 12-digit dev account. Required for deploy-debug.sh --execute; checked by every script when set.
LAI_DEV_ACCOUNT_ID=
# AWS_PROFILE=lai-dev
# AWS_REGION=us-west-1            # the frontend stack is always us-east-1 (CloudFront)
# Bedrock runtime Region (ADR-064): where LaiAiGuardrail-dev is deployed and Bedrock is called.
# Default: AWS_REGION. us-west-1 is a source Region of the US Claude Haiku 4.5 profile; set
# us-west-2 only if us-west-1 cannot invoke it (README, "Bedrock and Polly"). EC2, RDS, SQS,
# Lambda and logs never move.
# LAI_DEV_BEDROCK_REGION=us-west-1

# --- host names (default lai / api / ladm .pauldimitriu.com) -----------------------------------
LAI_SITE_DOMAIN=lai.pauldimitriu.com
LAI_API_DOMAIN=api.pauldimitriu.com
LAI_ADMIN_DOMAIN=ladm.pauldimitriu.com

# Route 53: both or neither. Without a zone the stack opens port 80 for Let's Encrypt HTTP-01 and
# deploy-debug.sh prints the DNS records (and the ACM validation CNAME) to create by hand.
LAI_HOSTED_ZONE_ID=
LAI_HOSTED_ZONE_NAME=

# --- Cognito (public identifiers, not secrets; left blank here on purpose) ---------------------
# The existing parent user pool, e.g. us-west-1_AbCdEf123, and its public web client id(s),
# comma separated. The first client id is the one the React build uses.
LAI_COGNITO_USER_POOL_ID=
LAI_COGNITO_CLIENT_IDS=

# --- access, certificates, alerts ----------------------------------------------------------------
# An IPv4 CIDR allowed to reach the API and admin hosts directly (e.g. 203.0.113.7/32). Empty:
# only CloudFront reaches the instance and the admin host is closed to the internet.
LAI_ADMIN_ALLOWED_CIDR=
# Let's Encrypt account email (empty allowed).
LAI_CERT_EMAIL=
# Alarm and budget email; the monthly budget is created only when an email is set.
LAI_ALARM_EMAIL=
LAI_MONTHLY_BUDGET_USD=40

# --- sizes ----------------------------------------------------------------------------------------
LAI_INSTANCE_TYPE=t4g.small         # Graviton (ARM64) only
LAI_EC2_VOLUME_SIZE=15              # GiB, at least 10
LAI_DB_INSTANCE_CLASS=db.t4g.micro
LAI_DB_STORAGE=20                   # GiB
LAI_DB_BACKUP_RETENTION=3           # days
LAI_DB_DELETION_PROTECTION=true

# --- nightly stop and morning start -----------------------------------------------------------
LAI_ENABLE_SCHEDULE=true
LAI_SHUTDOWN_TIME=00:00             # HH:MM in LAI_SCHEDULE_TIMEZONE
LAI_AVAILABLE_BY=08:00              # when the environment should be usable
LAI_STARTUP_WARMUP_MINUTES=25       # startup begins this long before LAI_AVAILABLE_BY (07:35)
LAI_SCHEDULE_TIMEZONE=America/Los_Angeles

# --- Lambda workers ---------------------------------------------------------------------------
LAI_ENABLE_LAMBDA=true
LAI_LAMBDA_MEMORY=512               # MB
LAI_LAMBDA_CONCURRENCY=2            # SQS maximum concurrency (at least 2)

# --- GitHub ---------------------------------------------------------------------------------------
LAI_GITHUB_REPOSITORY=paulj3000/learning

# --- rarely needed --------------------------------------------------------------------------------
# LAI_RELEASE_RETENTION_DAYS=45     # releases/ lifecycle in the artifacts bucket
# LAI_CREATE_OIDC_PROVIDER=false    # detected automatically (false when GitHub's provider exists)
# LAI_ALLOW_LEGACY_DEV_STACK=false  # true: proceed although LaiDjangoEc2-dev is still deployed
# LAI_DEV_STOPPED_DEPLOY=defer      # dev-release.sh deploy while stopped: defer (pending) or start
