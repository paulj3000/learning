{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/paulj3000/learning/scripts/release/processing-release-manifest.schema.json",
  "title": "Processing worker release manifest (ADR-071)",
  "description": "One immutable release of the background processing workers: every artifact by content-addressed key and SHA-256, the functions it is deployed to and the job kinds they accept. Written by scripts/release/processing_release.py manifest create, stored create-only at releases/processing/<git_sha>.json in the environment's artifacts bucket, and used for verification, the pre-enable check and rollback.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment",
    "git_sha",
    "created_at",
    "manifest_key",
    "previous_manifest_key",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "environment": { "enum": ["dev", "prod"] },
    "git_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "manifest_key": { "type": "string", "pattern": "^releases/processing/[a-f0-9]{40}\\.json$" },
    "previous_manifest_key": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^releases/processing/[a-f0-9]{40}\\.json$" }
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "file",
          "key",
          "sha256",
          "size_bytes",
          "functions",
          "supported_kinds"
        ],
        "properties": {
          "name": {
            "enum": [
              "jobs-worker",
              "audio-worker",
              "ffmpeg-layer",
              "image-worker",
              "optimize-worker"
            ]
          },
          "type": { "enum": ["function-zip", "layer-zip"] },
          "file": { "type": "string", "pattern": "^[a-z-]+/[A-Za-z0-9._-]+\\.zip$" },
          "key": {
            "type": "string",
            "pattern": "^lambda/(layers/)?[A-Za-z0-9._-]+-[a-f0-9]{16}\\.zip$"
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 1 },
          "functions": {
            "type": "array",
            "items": { "type": "string", "pattern": "^lai-(dev|prod)-jobs-[a-z]+$" }
          },
          "supported_kinds": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z]+(\\.[a-z_]+)+$" }
          }
        }
      }
    }
  }
}
