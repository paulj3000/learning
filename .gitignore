# Third-party art packs. These are the *source* archives the importer reads,
# not build output: 283 MB and growing, re-downloadable from the urls in
# docs/ASSET_SOURCING.md, and verifiable against the sha256 recorded for each
# in docs/ASSET_LICENCES.md. What ships is the handful of normalised files
# the importer writes into react/public/models/, which are checked in.
assets/*.zip

# Django collectstatic output (LAI-0404); built in the container, never committed
lai/staticfiles/

# Local asset-library storage (LAI-2200)
lai/.asset-storage/
# local processing stores and queues (LAI_PROCESSING_LOCAL_ROOT, LAI-LAMBDA-004)
lai/.processing-local/
lai/.child-photo-storage/

# CDK synth output (infra/)
infra/cdk.out/
/build/
