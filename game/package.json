{
  "name": "@lai/game-engine",
  "version": "0.1.0",
  "description": "Learning Adventure Island Game Engine Core: the shared Three.js runtime, movement, camera, gameplay components and Realm/Adventure SDK (ADR-020). Imports no React, Django client or AWS SDK.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts/index.ts",
    "./core": "./src/core/index.ts",
    "./debug": "./src/debug/index.ts",
    "./sdk": "./src/sdk/index.ts",
    "./services": "./src/services/index.ts",
    "./components": "./src/components/index.ts",
    "./environment": "./src/environment/index.ts",
    "./camera": "./src/camera/index.ts",
    "./animation": "./src/animation/index.ts",
    "./character": "./src/character/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "three": "^0.185.1"
  }
}
