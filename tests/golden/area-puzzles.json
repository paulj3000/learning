{
  "schemaVersion": 1,
  "suite": "area-puzzles",
  "description": "Puzzle rules the client simulates and the server grades: observe every feature, match each gap to a stone of its size, and move steam along valves to the goal.",
  "sources": [
    "react/src/features/region-play/areaPuzzles.ts",
    "lai/apps/regions/puzzles.py"
  ],
  "notes": [
    "simulateValves: a valve whose channel has no steam does nothing, so extra turns are harmless.",
    "platformsSolved: an unknown slot or stone id is an invalid submission (throws).",
    "chooseAnswerCorrect and orderSequenceCorrect take the variants and a submission {variantId, choice} or {variantId, order}; an unknown variant, option or item, or an order that is not a permutation of the variant items, is an invalid submission (throws)."
  ],
  "functions": {
    "observeSolved": {
      "python": "observe_solved",
      "args": [
        "featureIds",
        "observed"
      ],
      "cases": [
        {
          "name": "all seen",
          "input": {
            "featureIds": [
              "a",
              "b"
            ],
            "observed": [
              "b",
              "a"
            ]
          },
          "expected": true
        },
        {
          "name": "one missing",
          "input": {
            "featureIds": [
              "a",
              "b"
            ],
            "observed": [
              "a"
            ]
          },
          "expected": false
        },
        {
          "name": "repeats are fine",
          "input": {
            "featureIds": [
              "a"
            ],
            "observed": [
              "a",
              "a"
            ]
          },
          "expected": true
        },
        {
          "name": "extras do not count",
          "input": {
            "featureIds": [
              "a",
              "b"
            ],
            "observed": [
              "a",
              "c"
            ]
          },
          "expected": false
        }
      ]
    },
