                },
                {
                  "type": "DISCOVERY_PRESENT",
                  "discoveryId": "tide-pool"
                }
              ]
            },
            "context": {
              "worldChangeKeys": [],
              "ownedItemIds": [],
              "discoveredIds": []
            }
          },
          "expected": false
        },
        {
          "name": "one requirement missing",
