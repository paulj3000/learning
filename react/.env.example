# Copy to react/.env.local (gitignored) for `npm run dev` against a local Django.
# docs/TREASURE_RUSH_LOCAL_DEV.md; ADR-038.

# Use the Django API through the Vite dev proxy.
VITE_BACKEND=django
# Sign in with a local Django parent (manage.py create_local_parent). `cognito` (the default)
# uses Amplify Auth. `django` works only under `vite dev`: a build refuses it.
VITE_AUTH_PROVIDER=django
# Optional; must be a loopback origin.
DJANGO_DEV_PROXY_TARGET=http://127.0.0.1:8000
