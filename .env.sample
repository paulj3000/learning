# Template for local development settings. Copy it to .env (untracked) and fill in the blanks:
#   cp .env.sample .env
# Nothing in this file is a secret; never put real secrets here.
#
# Docker Compose reads .env directly. `make migrate`, `make runserver`, `make django-check` and
# `make migrate-check` pass its values to Django, which has no dotenv package (README, "Python
# tooling"). Running manage.py without make does not read .env. Deployed environments never read
# it either: they use SSM Parameter Store (docs/platform/DJANGO_EC2_DEPLOYMENT.md, section 4.3).
# Format: NAME=value, no quotes. A variable already exported in your shell wins.

# --- Database (compose PostgreSQL on 127.0.0.1) ----------------------------------------------
POSTGRES_DB=lai
POSTGRES_USER=lai
POSTGRES_PASSWORD=local-dev-only-password
# Change if 5432 is taken on your machine (the same value is used by `make up` and Django).
POSTGRES_PORT=5432
# Optional: a full URL overrides the POSTGRES_* values above (local settings only).
# DATABASE_URL=postgresql://lai:local-dev-only-password@127.0.0.1:5432/lai

# --- Django ------------------------------------------------------------------------------------
# Local settings have safe defaults for these; uncomment to change them.
# DJANGO_SECRET_KEY=local-development-only-not-a-secret
# DJANGO_DEBUG=true
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# DJANGO_LOG_LEVEL=INFO
# DJANGO_ADMIN_URL_PATH=admin/

# --- Development ports ---------------------------------------------------------------------------
# `make runserver` binds Django to this port and the Vite dev server proxies /api to it, so set it
# once here (default 8010). Example: DJANGO_DEV_PORT=8000.
# DJANGO_DEV_PORT=8010

# --- Cognito (required: if any is empty, every API request is rejected; ADR-040) --------------
# The existing Cognito user pool (Cognito console, or ask the owner). No Amplify sandbox is needed.
# `npm run dev` reuses COGNITO_USER_POOL_ID and the first client id below for browser sign-in,
# unless react/.env.local sets VITE_COGNITO_* (react/.env.example).
COGNITO_REGION=
COGNITO_USER_POOL_ID=
# Comma-separated allow-list of app client ids. List the web client first (web, then Android).
COGNITO_ALLOWED_CLIENT_IDS=

# --- Asset library (LAI-2200) ------------------------------------------------------------------
# local stores files under lai/.asset-storage and serves them through Django.
LAI_ASSET_STORAGE=local
LAI_ASSET_DELIVERY=django
# For S3 instead: LAI_ASSET_STORAGE=s3, LAI_ASSET_BUCKET=<bucket>, LAI_ASSET_REGION=<region>
# LAI_ASSET_URL_TTL_SECONDS=3600
# LAI_ASSET_MAX_UPLOAD_BYTES=52428800

# --- Game-only WebView launch (LAI-ANDROID-API-001, ADR-036) -----------------------------------
# runserver is plain HTTP, so the game cookie must not be Secure locally.
LAI_GAME_COOKIE_SECURE=false
# LAI_GAME_ENTRY_URL=/game/
# LAI_GAME_ALLOWED_ORIGINS=
# LAI_GAME_TICKET_TTL_SECONDS=60
# LAI_GAME_SESSION_TTL_SECONDS=3600
# LAI_GAME_LAUNCH_RATE=30/min
